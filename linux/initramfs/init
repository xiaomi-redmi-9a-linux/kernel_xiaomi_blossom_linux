#!/bin/busybox sh

PATH=/bin:/sbin
export PATH

# Install applet links before setup so the initramfs has the full BusyBox
# toolbox even if a later mount or rootfs step fails.
/bin/busybox --install -s /bin 2>/dev/null || true

LOG_FILE=

log_state() {
	[ -n "${LOG_FILE}" ] || return 0
	{
		echo "=== ${1} ==="
		echo "kernel command line:"
		cat /proc/cmdline
		echo "kernel log:"
		dmesg
	} >> "${LOG_FILE}" 2>&1
	/bin/busybox sync
}

fail() {
	echo "native-linux initramfs: $*" >/dev/console
	echo "Kernel command line:" >/dev/console
	cat /proc/cmdline >/dev/console 2>&1
	echo "Recent kernel messages:" >/dev/console
	dmesg | tail -n 40 >/dev/console 2>&1
	if [ -n "${LOG_FILE}" ]; then
		{
			echo "=== failure: $* ==="
			cat /proc/cmdline
			dmesg
		} >> "${LOG_FILE}" 2>&1
		/bin/busybox sync
	fi
	if [ -c /dev/ttyGS0 ]; then
		echo "Opening emergency shell on USB ACM (/dev/ttyGS0)." >/dev/console
		exec /bin/busybox sh -i </dev/ttyGS0 >/dev/ttyGS0 2>&1
	fi
	echo "No USB ACM console; opening shell on the device console." >/dev/console
	exec /bin/busybox sh
}

mount -t devtmpfs devtmpfs /dev || fail "could not mount devtmpfs"
mount -t proc proc /proc || fail "could not mount proc"
mount -t sysfs sysfs /sys || fail "could not mount sysfs"
echo "1 4 1 7" > /proc/sys/kernel/printk 2>/dev/null || true

# USB Gadget setup (configured for USB tethering on-demand, ACM serial disabled)
USB_GADGET=/sys/kernel/config/usb_gadget/native-linux
mkdir -p /sys/kernel/config
if mount -t configfs none /sys/kernel/config 2>/dev/null; then
	mkdir -p "${USB_GADGET}"
	if [ -d "${USB_GADGET}" ]; then
		printf "0x2717" > "${USB_GADGET}/idVendor" 2>/dev/null || true
		printf "0xff40" > "${USB_GADGET}/idProduct" 2>/dev/null || true
		printf "0x0100" > "${USB_GADGET}/bcdDevice" 2>/dev/null || true
		printf "0x0200" > "${USB_GADGET}/bcdUSB" 2>/dev/null || true
		mkdir -p "${USB_GADGET}/strings/0x409" \
			"${USB_GADGET}/configs/c.1/strings/0x409" \
			"${USB_GADGET}/functions/rndis.usb0"
		printf "Xiaomi" > "${USB_GADGET}/strings/0x409/manufacturer" 2>/dev/null || true
		printf "Redmi 9A Linux" > "${USB_GADGET}/strings/0x409/product" 2>/dev/null || true
		printf "dandelion" > "${USB_GADGET}/strings/0x409/serialnumber" 2>/dev/null || true
		printf "USB Tethering" > "${USB_GADGET}/configs/c.1/strings/0x409/configuration" 2>/dev/null || true
	fi
fi

mkdir -p /mnt/sd /newroot || fail "could not create mount points"

SD_PARTITION=/dev/mmcblk1p1

attempt=0
while [ ! -b "${SD_PARTITION}" ] && [ "${attempt}" -lt 12 ]; do
	sleep 1
	attempt=$((attempt + 1))
done

[ -b "${SD_PARTITION}" ] || fail "microSD partition ${SD_PARTITION} did not appear"

# Auto-mount exFAT, ext4, or vfat/FAT32
mount -o rw "${SD_PARTITION}" /mnt/sd 2>/dev/null || \
mount -t exfat -o rw "${SD_PARTITION}" /mnt/sd 2>/dev/null || \
mount -t ext4 -o rw "${SD_PARTITION}" /mnt/sd 2>/dev/null || \
mount -t vfat -o rw "${SD_PARTITION}" /mnt/sd || fail "could not mount microSD partition (tried exfat, ext4, vfat)"

LOG_FILE=/mnt/sd/native-linux-boot.log
: > "${LOG_FILE}" || fail "could not create ${LOG_FILE}"
log_state "microSD mounted"

# Select rootfs image: support Alpine (linux-rootfs.ext4) and Droidian (droidian-rootfs.ext4)
IS_DROIDIAN=0
if [ -f /mnt/sd/linux-rootfs.ext4 ]; then
	ROOTFS_IMAGE=/mnt/sd/linux-rootfs.ext4
	IS_DROIDIAN=0
elif [ -f /mnt/sd/droidian-rootfs.ext4 ]; then
	ROOTFS_IMAGE=/mnt/sd/droidian-rootfs.ext4
	IS_DROIDIAN=1
else
	fail "no rootfs found on microSD (expected linux-rootfs.ext4 or droidian-rootfs.ext4)"
fi

log_state "rootfs image found: ${ROOTFS_IMAGE}"

losetup /dev/loop0 "${ROOTFS_IMAGE}" || fail "could not attach the ext4 rootfs image"
log_state "loop device attached"
mount -t ext4 -o rw,noatime /dev/loop0 /newroot || fail "could not mount the ext4 rootfs image"
log_state "rootfs mounted"

# Self-healing: restore clean working network configuration if needed
if [ -d /newroot/etc/wpa_supplicant ]; then
	cat << 'EOF_WPA' > /newroot/etc/wpa_supplicant/wpa_cli.sh
#!/bin/sh
IFNAME="${1}"
ACTION="${2}"
DHCPIDFILE="/var/run/udhcpc.${IFNAME}.pid"

case "${ACTION}" in
	CONNECTED)
		logger -t wpa_cli "Interface ${IFNAME} CONNECTED: acquiring DHCP lease..."
		if [ -e "${DHCPIDFILE}" ]; then
			read -r DHCPID < "${DHCPIDFILE}"
			kill -USR1 "${DHCPID}" 2>/dev/null || udhcpc -b -R -p "${DHCPIDFILE}" -i "${IFNAME}"
		else
			udhcpc -b -R -p "${DHCPIDFILE}" -i "${IFNAME}"
		fi
		;;
	DISCONNECTED)
		logger -t wpa_cli "Interface ${IFNAME} DISCONNECTED"
		if [ -e "${DHCPIDFILE}" ]; then
			read -r DHCPID < "${DHCPIDFILE}"
			kill -USR2 "${DHCPID}" 2>/dev/null
		fi
		;;
esac
EOF_WPA
	chmod 0755 /newroot/etc/wpa_supplicant/wpa_cli.sh
fi

if [ -d /newroot/etc/network ]; then
	cat << 'EOF_NET' > /newroot/etc/network/interfaces
auto lo
iface lo inet loopback

auto wlan0
iface wlan0 inet dhcp
EOF_NET
fi

# If booting Droidian, setup vendor partition, block symlinks, and container mounts
if [ "${IS_DROIDIAN}" -eq 1 ]; then
	echo "Droidian detected: setting up Halium hardware environment..." >/dev/console

	# 1. Create Android by-name block device symlinks
	mkdir -p /dev/block/by-name /dev/block/bootdevice/by-name /dev/block/platform/bootdevice/by-name
	for u in /sys/class/block/*/uevent; do
		[ -f "$u" ] || continue
		PARTNAME=""
		DEVNAME=""
		. "$u"
		if [ -n "$PARTNAME" ] && [ -n "$DEVNAME" ]; then
			ln -sf "/dev/${DEVNAME}" "/dev/block/by-name/${PARTNAME}"
			ln -sf "/dev/${DEVNAME}" "/dev/block/bootdevice/by-name/${PARTNAME}"
			ln -sf "/dev/${DEVNAME}" "/dev/block/platform/bootdevice/by-name/${PARTNAME}"
		fi
	done

	# 2. Mount internal Android /vendor partition (read-only)
	# If /vendor is a pre-existing or broken symlink, remove the symlink so we can mount a real directory
	if [ -L /newroot/vendor ] || [ -h /newroot/vendor ]; then
		rm -f /newroot/vendor
	fi
	mkdir -p /newroot/vendor
	if [ -b "/dev/block/by-name/vendor" ]; then
		mount -t ext4 -o ro /dev/block/by-name/vendor /newroot/vendor 2>/dev/null || \
		mount -o ro /dev/block/by-name/vendor /newroot/vendor 2>/dev/null || \
		echo "Warning: could not mount /dev/block/by-name/vendor" >/dev/console
	fi

	# 3. Bind-mount /vendor into paths expected by Halium / LXC container
	for p in /newroot/var/lib/lxc/android/rootfs/vendor /newroot/android/vendor /newroot/system/vendor; do
		if [ -L "${p}" ] || [ -h "${p}" ]; then
			rm -f "${p}"
		fi
		mkdir -p "${p}" 2>/dev/null || true
		mount -o bind,ro /newroot/vendor "${p}" 2>/dev/null || true
	done
fi

if [ -d /lib/firmware ]; then
	mkdir -p /newroot/lib/firmware
	cp -an /lib/firmware/* /newroot/lib/firmware/ 2>/dev/null || true
fi

# Enable automatic root shell on tty1 (phone screen)
if [ -f /newroot/etc/inittab ]; then
	sed -i 's/^[a-zA-Z0-9_]*:.*getty/#&/' /newroot/etc/inittab
	sed -i '/::respawn:\/bin\/sh/d' /newroot/etc/inittab
	sed -i '/::respawn:\/sbin\/getty/d' /newroot/etc/inittab
	sed -i '/ttyGS0/d' /newroot/etc/inittab
	echo "tty1::respawn:/bin/sh -l" >> /newroot/etc/inittab
fi
rm -f /newroot/etc/runlevels/*/agetty* /newroot/etc/runlevels/*/getty* 2>/dev/null || true

# Silence OpenRC /lib/modules missing warning
mkdir -p /newroot/lib/modules/4.19.325-cip136-st8-linux-unified
touch /newroot/lib/modules/4.19.325-cip136-st8-linux-unified/modules.dep \
      /newroot/lib/modules/4.19.325-cip136-st8-linux-unified/modules.alias \
      /newroot/lib/modules/4.19.325-cip136-st8-linux-unified/modules.symbols \
      /newroot/lib/modules/4.19.325-cip136-st8-linux-unified/modules.builtin 2>/dev/null || true

# Ensure MTK connectivity device nodes exist in /dev
for cdev in wmtWifi stpwmt wmtdetect stpbt stpgps; do
	if [ -f "/sys/class/${cdev}/${cdev}/dev" ] && [ ! -e "/dev/${cdev}" ]; then
		mknod "/dev/${cdev}" c $(tr ':' ' ' < "/sys/class/${cdev}/${cdev}/dev") 2>/dev/null || true
	fi
done

mkdir -p /newroot/dev /newroot/proc /newroot/sys /newroot/run /newroot/boot ||
	fail "could not prepare Linux mount points"
mount -o move /dev /newroot/dev || fail "could not move /dev"
mount -o move /proc /newroot/proc || fail "could not move /proc"
mount -o move /sys /newroot/sys || fail "could not move /sys"
mount -o move /mnt/sd /newroot/boot || fail "could not move the microSD mount"

# For Droidian: initialize binderfs and release UDC for usb-tethering
if [ "${IS_DROIDIAN}" -eq 1 ]; then
	mkdir -p /newroot/dev/binderfs
	if mount -t binder binder /newroot/dev/binderfs 2>/dev/null; then
		chmod 0755 /newroot/dev/binderfs 2>/dev/null || true
		for b in binder hwbinder vndbinder; do
			if [ -c "/newroot/dev/binderfs/${b}" ]; then
				chmod 0666 "/newroot/dev/binderfs/${b}" 2>/dev/null || true
				ln -sf "/dev/binderfs/${b}" "/newroot/dev/${b}"
			fi
		done
	fi

	# Release UDC so Droidian's usb-tethering service can claim it
	if [ -d "/newroot/sys/kernel/config/usb_gadget/native-linux" ]; then
		echo "" > "/newroot/sys/kernel/config/usb_gadget/native-linux/UDC" 2>/dev/null || true
	fi
fi

LOG_FILE=/newroot/boot/native-linux-boot.log
log_state "switch_root starting"
INIT_BIN="/sbin/init"
if [ -x "/newroot/lib/systemd/systemd" ]; then
	INIT_BIN="/lib/systemd/systemd"
elif [ -x "/newroot/usr/lib/systemd/systemd" ]; then
	INIT_BIN="/usr/lib/systemd/systemd"
elif [ -x "/newroot/sbin/init" ]; then
	INIT_BIN="/sbin/init"
elif [ -x "/newroot/bin/sh" ]; then
	INIT_BIN="/bin/sh"
fi

exec switch_root /newroot "${INIT_BIN}"
fail "switch_root returned unexpectedly"
